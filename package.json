{
  "name": "n8n-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android app (PWA + APK) to monitor and run your self-hosted n8n workflows.",
  "scripts": {
    "start": "node server.js",
    "android:add": "cap add android",
    "android:assets": "capacitor-assets generate --android --assetPath assets",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
