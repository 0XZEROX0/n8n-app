<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget: header (2+ rows only) and a grid of workflow tiles, one per cell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="n8n"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingStart="8dp"
            android:singleLine="true"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:contentDescription="Refresh"
            android:padding="4dp"
            android:src="@drawable/widget_ic_refresh" />

        <ImageView
            android:id="@+id/widget_settings"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:contentDescription="Pick workflows"
            android:padding="4dp"
            android:src="@drawable/widget_ic_tune" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="6dp"
        android:text="Loading…"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
