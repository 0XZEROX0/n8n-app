<?xml version="1.0" encoding="utf-8"?>
<!-- One workflow on a 2x2 block: name, result of the last run, when and how long,
     what starts it, and the last 10 runs as dots, with a play button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="3dp"
    android:layout_weight="1"
    android:background="@drawable/widget_tile_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tile_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle" />

        <TextView
            android:id="@+id/tile_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingStart="6dp"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tile_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text_dim"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tile_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_text_dim"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tile_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_text_dim"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            <ImageView
                android:id="@+id/tile_h0"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h4"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h5"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h6"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h7"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h8"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/tile_h9"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_idle"
                android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/tile_play"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Run workflow"
            android:padding="9dp"
            android:src="@drawable/widget_ic_play" />
    </LinearLayout>
</LinearLayout>
