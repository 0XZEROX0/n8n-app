<?xml version="1.0" encoding="utf-8"?>
<!-- One workflow on a 2x2 block. The play button sits next to the name at the top, so it is
     never cut off; the lines below it are short so they fit even on small home screen grids:
     name + play / result / when + how long / trigger + state / last 10 runs as dots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="3dp"
    android:layout_weight="1"
    android:background="@drawable/widget_tile_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tile_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Run workflow"
            android:padding="8dp"
            android:src="@drawable/widget_ic_play" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tile_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle" />

        <TextView
            android:id="@+id/tile_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingStart="5dp"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tile_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_text_dim"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tile_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_text_dim"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tile_h0"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h4"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h5"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h6"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h7"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h8"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/tile_h9"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tile_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingStart="2dp"
            android:singleLine="true"
            android:textColor="@color/widget_text_dim"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
